// Copy to secrets.h (gitignored) and fill in. These are only the *first boot*
// defaults — once the device has booted, WiFi credentials live in NVS and
// can be changed from the web UI without reflashing.
#pragma once

#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// ArduinoOTA password. Must match `upload_flags = --auth=...` in platformio.ini.
#define OTA_PASSWORD  "pet-pc"
