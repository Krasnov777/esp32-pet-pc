// Copy to secrets.h (gitignored) and fill in. The build fails without it on
// purpose: no default passwords ship in this public repo.
#pragma once

// Optional first-boot WiFi defaults. Once the device has booted, WiFi
// credentials live in NVS and can be changed from the web UI without reflashing.
// #define WIFI_SSID     "your-ssid"
// #define WIFI_PASSWORD "your-wifi-password"

// ArduinoOTA push password. `pio run -e ota -t upload` reads it from the
// PETPC_OTA_PASSWORD environment variable.
#define OTA_PASSWORD "change-me"

// HTTP Basic auth for the web UI and every /api/* route.
#define WEB_USER     "admin"
#define WEB_PASSWORD "change-me-too"
